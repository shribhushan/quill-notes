### ── Android ────────────────────────────────────────────────
*.apk
*.aab
*.ap_
*.dex
*.class

# Built output
bin/
gen/
out/
build/
app/build/

# Gradle caches (the wrapper jar itself IS committed — needed for ./gradlew to work)
.gradle/

# Android Studio project files
*.iml
*.iws
*.ipr
.idea/
local.properties
captures/
.externalNativeBuild/
.cxx/

# NDK
obj/

# Keystore files — NEVER commit these
*.jks
*.keystore
*.p12
# Exception: a shared, non-sensitive debug-only signing key (fixed default
# passwords, no production trust) so local builds, CI, and anyone testing
# OAuth-based cloud sync all get the same stable SHA-1 fingerprint to
# register with Google/Microsoft. Never use this for a Play Store release.
!app/ci-debug.keystore

# Signing config if stored in a properties file
keystore.properties
release.properties

### ── Secrets & API keys ────────────────────────────────────
google-services.json
# Keep msal_config.json tracked but remind devs to fill in their own client_id
# If you add real secrets to it, uncomment the next line:
# app/src/main/res/raw/msal_config.json

