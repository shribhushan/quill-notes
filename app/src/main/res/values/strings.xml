    <string name="onboarding_1_body">Notes, checklists, photos, a daily journal and a planner — with reminders, notebooks and fast search.</string>
    <string name="onboarding_2_title">Private by design</string>
    <string name="onboarding_2_body">Every note is encrypted on your phone. No ads, no tracking, and an optional lock for the app or for single notes.</string>
    <string name="onboarding_3_title">Never lose a note</string>
    <string name="onboarding_3_body">Back up to your own Google Drive and restore on a new phone with your passphrase. Or export everything, any time.</string>
